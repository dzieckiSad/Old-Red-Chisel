# Copy to .env.local for local development, and set the same names in the hosting's environment
# variables for the live site (works on any Node.js host). See docs/SETUP.md.

# Private preview: when set (6+ characters), every page asks for this password first.
# Remove it to open the site to everyone.
SITE_PASSWORD=

# Where the site keeps its files on an ordinary server: embedded database (when DATABASE_URL is
# empty), uploaded photos and its signing key. Default: .data next to the app. Back it up.
DATA_DIR=

# Any PostgreSQL (e.g. Neon, or one on your own server). Empty = embedded database in DATA_DIR.
DATABASE_URL=

# Only for serverless hosts that don't keep files (e.g. Vercel): photos go to Vercel Blob.
# On an ordinary server leave empty: photos are kept in DATA_DIR/uploads.
BLOB_READ_WRITE_TOKEN=

# Card payments (Stripe → Developers → API keys). Without them, development (npm run dev) uses a
# simulated payment button and production shows "online payment opens soon".
# ALLOW_DEMO_PAYMENTS=1 turns the simulated button on in production too: never on the live shop.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails (resend.com): new orders and quote requests to the workshop (the email set in Admin →
# Content), order details to customers. Without a key, emails are only written to the server log.
RESEND_API_KEY=
# Public address of the site, used for links in emails (e.g. https://www.oldredchisel.ie).
SITE_URL=
# Leave empty until a domain is verified in Resend; then e.g. "Old Red Chisel <orders@oldredchisel.ie>".
EMAIL_FROM=

# Admin panel at /admin: one shared password (8+ characters). Changing it signs everyone out.
# While the site is being built, the panel uses "admin123" when this is empty.
ADMIN_PASSWORD=
