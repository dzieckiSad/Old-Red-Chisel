# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for the live site.
# See docs/SETUP.md for where each value comes from.

# Database (added automatically by Vercel's Neon integration). Leave unset locally to use
# the embedded database in .data/.
DATABASE_URL=

# Signs customer and admin sessions and encrypts short-lived secrets. 32+ random characters.
SESSION_SECRET=

# Card payments (Stripe → Developers → API keys). Without them, non-production sites use a
# simulated payment button and the live site shows "online payment opens soon".
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Order emails (resend.com). Without a key, emails are only written to the server log.
RESEND_API_KEY=
EMAIL_FROM="Old Red Chisel <orders@oldredchisel.ie>"

# Admin panel. ADMIN_PATH is the secret address (12+ letters, digits, - or _), e.g.
# https://oldredchisel.ie/<ADMIN_PATH>. ADMIN_SETUP_KEY (16+ characters) is asked for once,
# when creating the admin account.
ADMIN_PATH=
ADMIN_SETUP_KEY=
